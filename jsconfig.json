{
  "compilerOptions": {
    "checkJs": true,
    "strict": true,
    // relaxed for now — enabling these needs JSDoc params + null guards
    // across all DOM code; tighten one flag at a time when annotating.
    "strictNullChecks": false,
    "noImplicitAny": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "lib": ["es2022", "dom", "dom.iterable"],
    "types": ["chrome"]
  },
  "include": ["core", "sidepanel", "options", "background"]
}
